{
  "name": "your-home-calculators",
  "version": "1.0.0",
  "description": "Your Home - Real Estate Financial Calculators Portal & Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build:frontend": "npm --prefix Frontend run build",
    "build": "npm run build:frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "node --test"
  },
  "keywords": [
    "real-estate",
    "calculator",
    "emi",
    "true-cost",
    "property",
    "finance"
  ],
  "author": "Your Home Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "pg@8.23.0": true
  }
}
